# Database
# In production (e.g. Neon), DATABASE_URL should be the pooled connection
# string and DIRECT_URL the unpooled one -- migrations run over DIRECT_URL
# since PgBouncer transaction-mode pooling doesn't support what Prisma's
# migration engine needs. Locally, both can point at the same database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/cloudops_simulator?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/cloudops_simulator?schema=public"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-secret-key-change-this-in-production"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Email Configuration
EMAIL_USER="your-email@example.com"
EMAIL_APP_PASSWORD="your-email-app-password"
EMAIL_FROM="CloudOps Simulator <your-email@example.com>"

# Google Sign-In (optional -- /api/auth/google returns a clear error if this
# isn't set, rather than breaking anything else). Must be the SAME Client ID
# as the frontend's VITE_GOOGLE_CLIENT_ID -- this is what the backend checks
# the token's audience against.
GOOGLE_CLIENT_ID=

# GitHub Sign-In (optional -- /api/auth/github returns a clear error if
# these aren't set). Create a GitHub OAuth App at
# https://github.com/settings/developers -- unlike Google, GitHub OAuth
# Apps have exactly ONE registered callback URL, so you'll likely want a
# separate app for local dev (callback: http://localhost:8080/auth/github/callback)
# vs. production (callback: https://your-domain/auth/github/callback).
# GITHUB_CLIENT_SECRET is genuinely secret -- never expose it to the
# frontend (unlike the Google/GitHub Client IDs, which are not secret).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Error monitoring (optional -- inert with no console/behavior change if
# unset). Get a DSN from https://sentry.io after creating a project.
SENTRY_DSN=
