// Prisma Schema for CloudOps Simulator

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations run over a direct (unpooled) connection -- Neon's pooled
  // endpoint uses PgBouncer in transaction mode, which doesn't support the
  // long-lived sessions/prepared statements Prisma's migration engine needs.
  directUrl = env("DIRECT_URL")
}

// User account and authentication
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  otpCode      String?   @map("otp_code")
  otpExpiry    DateTime? @map("otp_expiry")
  isVerified   Boolean   @default(false) @map("is_verified")

  // Forgot-password flow -- kept separate from otpCode/otpExpiry (email
  // verification) so a pending verification code and a pending reset code
  // never collide or invalidate each other.
  resetPasswordOtp       String?   @map("reset_password_otp")
  resetPasswordOtpExpiry DateTime? @map("reset_password_otp_expiry")

  // Bumped on password change, password reset, or an explicit "log out of
  // all devices" request. Every JWT embeds the tokenVersion it was issued
  // with; authMiddleware rejects any token whose version doesn't match the
  // user's current one, which is what actually revokes already-issued
  // tokens (a bare JWT signature check can't do this on its own).
  tokenVersion Int @default(0) @map("token_version")

  isAdmin Boolean @default(false) @map("is_admin")

  // Plan & Subscription fields
  planType     String    @default("free") @map("plan_type") // "free" or "pro"
  isPro        Boolean   @default(false) @map("is_pro")
  planExpiry   DateTime? @map("plan_expiry") // When pro plan expires
  
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  applications Application[]
  instances    Instance[]
  containers   Container[]
  pipelines    Pipeline[]
  userProgress UserProgress[]
  images       DockerImage[]
  tickets      Ticket[]
  scenarios    Scenario[]
  dashboardState DashboardState[]
  networkingState NetworkingState[]
  gameState    GameState?
  alerts       Alert[]
  payments     Payment[]
  terraformWorkspace TerraformWorkspace?
  ansibleWorkspace   AnsibleWorkspace?
  vaultWorkspace     VaultWorkspace?
  gitopsWorkspace    GitOpsWorkspace?
  profile            UserProfile?

  @@map("users")
}

// Applications created by users
model Application {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  type      String?
  status    String   @default("running")
  image     String?
  port      Int?
  envVars   Json?    @map("env_vars") @db.JsonB
  strategy  String?  @default("Rolling") // Rolling, Blue/Green
  requests  Json?    @db.JsonB // CPU/Memory requests
  healthCheck Json?  @map("health_check") @db.JsonB
  activeVersion String? @map("active_version")
  deployments Json?  @db.JsonB // Array of deployment configurations
  assignedInstances Json? @map("assigned_instances") @db.JsonB // Array of instance IDs
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("applications")
}

// Cloud instances
model Instance {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  type            String   // t3.micro, m5.large, etc.
  status          String   @default("running") // provisioning, running, crashed, stopped, booting
  cpu             Float    @default(5) // Current CPU usage %
  memory          Float    @default(20) // Current memory usage %
  currentRps      Float    @default(0) @map("current_rps") // Current requests per second
  provisionTimer  Int      @default(0) @map("provision_timer") // Seconds until ready
  memoryLeakFactor Float   @default(0) @map("memory_leak_factor")
  scaledBy        String?  @map("scaled_by") // hpa, vpa, asg, manual
  roleId          String?  @map("role_id") // IAM role ID
  assignedAppId   String?  @map("assigned_app_id") // Application this instance serves
  pods            Json?    @db.JsonB // Array of pod objects running on this instance
  region          String   @default("us-east-1")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assignedAppId])
  @@map("instances")
}

// Docker containers
model Container {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  imageId     String?  @map("image_id") // Reference to Docker image
  imageName   String?  @map("image_name")
  image       String   // Full image name/tag
  status      String   @default("running") // starting, running, crashed, stopped
  port        String?
  cpuUsage    Float    @default(0) @map("cpu_usage")
  memoryUsage Float    @default(0) @map("memory_usage")
  currentRps  Float    @default(0) @map("current_rps")
  capacity    Int      @default(100) // Max RPS
  uptime      Int      @default(0) // Seconds
  restarts    Int      @default(0)
  position    Json?    @db.JsonB // {x, y} for UI visualization
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("containers")
}

// Docker images built by users
model DockerImage {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  baseImage  String?  @map("base_image") // nginx, node, python, redis
  tag        String   @default("latest")
  port       Int      @default(80)
  size       Int      @default(0) // MB
  status     String   @default("ready") // building, ready, failed
  buildProgress Int   @default(100) @map("build_progress") // 0-100
  dockerfile String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("docker_images")
}

// CI/CD Pipelines
model Pipeline {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  status    String   @default("pending")
  branch    String   @default("main")
  version   String?  @default("v1.0.0")
  steps     Json?    @db.JsonB
  logs      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pipelines")
}

// User learning progress
model UserProgress {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  module       String // docker, k8s, cicd, iam, etc.
  progressJson Json     @map("progress_json") @db.JsonB
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@map("user_progress")
}

// DevOps Tickets and Incidents
model Ticket {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  ticketNumber    String   @unique @map("ticket_number") // TK-0001 format
  title           String
  description     String   @db.Text
  type            String // incident, alert, task, change_request
  priority        String // critical, high, medium, low
  status          String   @default("open") // open, in_progress, resolved, closed
  category        String? // cpu, memory, scaling, deployment, network, pod, service
  affectedService String?  @map("affected_service")
  sourceEvent     String?  @map("source_event") @db.Text // JSON of the event that triggered this
  metricsSnapshot Json?    @map("metrics_snapshot") @db.JsonB
  suggestedFix    String?  @map("suggested_fix") @db.Text
  actionTaken     String?  @map("action_taken") @db.Text
  assignedTo      String?  @map("assigned_to")
  resolvedAt      DateTime? @map("resolved_at")
  closedAt        DateTime? @map("closed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities      TicketActivity[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("tickets")
}

// Ticket activity log
model TicketActivity {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  action      String // created, assigned, status_changed, comment_added, resolved, etc.
  description String   @db.Text
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_activities")
}

// Game Scenarios
model Scenario {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  type        String // traffic-spike, security-breach, cost-optimization, etc.
  status      String   @default("not_started") // not_started, in_progress, completed, failed
  progress    Int      @default(0) // 0-100
  score       Int?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("scenarios")
}

// Dashboard State (metrics and stats)
model DashboardState {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  traffic      Int      @default(0)
  cost         Float    @default(0)
  healthScore  Int      @default(100) @map("health_score")
  activeAlerts Int      @default(0) @map("active_alerts")
  uptimePercent Float   @default(100) @map("uptime_percent")
  metricsData  Json?    @map("metrics_data") @db.JsonB // historical metrics
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@index([userId])
  @@map("dashboard_state")
}

//  Networking State (ingress, services, pods)
model NetworkingState {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  ingressCount Int      @default(0) @map("ingress_count")
  serviceCount Int      @default(0) @map("service_count")
  podCount     Int      @default(0) @map("pod_count")
  traffic      Int      @default(0)
  bandwidth    Float    @default(0) // Mbps
  configurations Json?  @db.JsonB // detailed network configurations (pods, services, ingress, load balancers)
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@index([userId])
  @@map("networking_state")
}

// Terraform Lab: one workspace per user, holding authored config, last-applied
// state, and the apply/destroy history -- mirrors the plan/apply/state lifecycle.
model TerraformWorkspace {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  resourceCount Int      @default(0) @map("resource_count")
  appliedCount  Int      @default(0) @map("applied_count")
  config        Json?    @db.JsonB // authored resource blocks (the desired state)
  state         Json?    @db.JsonB // last-applied resource blocks (the tfstate)
  history       Json?    @db.JsonB // array of apply/destroy/drift events
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("terraform_workspaces")
}

// Ansible Lab: one workspace per user, holding the inventory, the playbook
// tasks authored against it, the per-host configured state after the last
// run, and the run history -- mirrors the run/re-run/idempotency lifecycle.
model AnsibleWorkspace {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  taskCount    Int      @default(0) @map("task_count")
  runCount     Int      @default(0) @map("run_count")
  inventory    Json?    @db.JsonB // hosts/groups the playbook targets
  playbook     Json?    @db.JsonB // authored tasks (the desired configuration)
  hostState    Json?    @map("host_state") @db.JsonB // last-converged state per host
  history      Json?    @db.JsonB // array of run/drift events
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("ansible_workspaces")
}

// Vault Lab: one workspace per user, holding enabled secrets engines, the
// secrets written into them (with version history), access-control policies,
// tokens with attached policies, and a log of allowed/denied read attempts.
model VaultWorkspace {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  secretCount  Int      @default(0) @map("secret_count")
  accessCount  Int      @default(0) @map("access_count")
  engines      Json?    @db.JsonB // enabled secrets engines (type + mount path)
  secrets      Json?    @db.JsonB // KV secrets, each with a version history
  policies     Json?    @db.JsonB // HCL access-control policies
  tokens       Json?    @db.JsonB // tokens with attached policy ids
  history      Json?    @db.JsonB // array of write/access-allowed/access-denied events
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("vault_workspaces")
}

// GitOps Lab: one workspace per user, holding GitOps "Application" links
// (each pointing at a real Application from the main simulator), the commit
// history that declares desired version/replicas, and a log of syncs,
// drift, and self-heals -- reconciliation happens against the real
// GameState applications, not a separate fake cluster.
model GitOpsWorkspace {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  commitCount  Int      @default(0) @map("commit_count")
  syncCount    Int      @default(0) @map("sync_count")
  apps         Json?    @db.JsonB // GitOps Application definitions (repo, target, sync policy)
  commits      Json?    @db.JsonB // commit history declaring desired version/replicas per app
  history      Json?    @db.JsonB // array of commit/sync/drift/self-heal events
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("gitops_workspaces")
}

// Personal info + which nav modules a user has chosen to have visible.
// selectedModules/onboardingComplete default to "everything, already done"
// so existing accounts (created before this feature) are unaffected --
// brand-new registrations explicitly override both to empty/false in the
// /auth/register handler, which is what actually triggers the forced
// first-run onboarding gate for them.
model UserProfile {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")

  fullName          String?   @map("full_name")
  phone             String?
  linkedinUrl       String?   @map("linkedin_url")
  instagramHandle   String?   @map("instagram_handle")
  dateOfBirth       DateTime? @map("date_of_birth")
  institute         String? // college / institute name
  occupation        String? // 'student' | 'professional' | 'other'

  selectedModules   String[]  @default(["dashboard","scenarios","applications","containers","terraform","ansible","vault","kubectl","gitops","networking","instances","cicd","live","cli","tickets","issues"]) @map("selected_modules")
  onboardingComplete Boolean  @default(true) @map("onboarding_complete")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("user_profiles")
}

// Game Simulation State (ASG, HPA, VPA, traffic, score, alerts)
model GameState {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  isRunning    Boolean  @default(false) @map("is_running")
  tick         Int      @default(0)
  score        Int      @default(0)
  scoreHistory Json?    @map("score_history") @db.JsonB // Array of score events
  pendingPods  Json?    @map("pending_pods") @db.JsonB // Array of pending pod requests
  scenario     String?  // Current scenario ID
  totalCost    Float    @default(0) @map("total_cost")
  
  // Infrastructure Config
  hasLoadBalancer Boolean @default(false) @map("has_load_balancer")
  asg          Json     @db.JsonB // ASG configuration object
  hpa          Json     @db.JsonB // HPA configuration object
  vpa          Json     @db.JsonB // VPA configuration object
  
  // Metrics
  traffic      Int      @default(0)
  targetTraffic Int     @default(0) @map("target_traffic")
  cpuAvg       Float    @default(0) @map("cpu_avg")
  errorRate    Float    @default(0) @map("error_rate")
  latencyAvg   Float    @default(0) @map("latency_avg")
  metricsHistory Json?  @map("metrics_history") @db.JsonB // Time-series metrics
  
  // Tutorial/Learning
  tutorialStep     Int     @default(0) @map("tutorial_step")
  tutorialComplete Boolean @default(false) @map("tutorial_complete")
  
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@index([userId])
  @@map("game_state")
}

// Alerts and Issues
model Alert {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String // cpu, memory, disk, network, security, etc.
  severity    String // critical, high, medium, low
  message     String   @db.Text
  source      String? // which service/instance triggered it
  status      String   @default("active") // active, acknowledged, resolved
  metadata    Json?    @db.JsonB
  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([severity])
  @@map("alerts")
}

// Payment & Subscription
model Payment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  razorpayOrderId String   @unique @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")
  amount          Int      // Amount in paise (e.g., 99900 for ₹999)
  currency        String   @default("INR")
  status          String   @default("created") // created, pending, completed, failed
  planType        String   @default("pro") @map("plan_type")
  planDurationDays Int     @default(30) @map("plan_duration_days")
  signature       String? // Razorpay signature for verification
  errorMessage    String? @db.Text @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
  @@map("payments")
}

