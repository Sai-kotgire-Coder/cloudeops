# Environment Variables for CloudOps Simulator Frontend

# Backend API URL
VITE_API_URL=http://localhost:3001/api

# Production example:
# VITE_API_URL=https://your-backend-project.vercel.app/api

# Google Sign-In (optional -- the "Continue with Google" button on
# Login/Register only renders when this is set). Get a Client ID from
# https://console.cloud.google.com/apis/credentials -- create an "OAuth
# client ID" of type "Web application", and add every URL the app is
# actually served from (e.g. http://localhost:8080 for dev, plus your
# production domain) under "Authorized JavaScript origins". This value is
# not secret -- it's meant to be embedded in frontend code.
VITE_GOOGLE_CLIENT_ID=
