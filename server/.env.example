# Database
# In production (e.g. Neon), DATABASE_URL should be the pooled connection
# string and DIRECT_URL the unpooled one -- migrations run over DIRECT_URL
# since PgBouncer transaction-mode pooling doesn't support what Prisma's
# migration engine needs. Locally, both can point at the same database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/cloudops_simulator?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/cloudops_simulator?schema=public"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-secret-key-change-this-in-production"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Email Configuration
EMAIL_USER="your-email@example.com"
EMAIL_APP_PASSWORD="your-email-app-password"
EMAIL_FROM="CloudOps Simulator <your-email@example.com>"
